# Used by both the application and the standalone overlay consumer configure.
function(_private_fm_path path label)
    if(NOT IS_ABSOLUTE "${path}" OR NOT EXISTS "${path}" OR "${path}" MATCHES "\\$<")
        message(FATAL_ERROR "Private libfm: invalid ${label}: ${path}")
    endif()
    get_filename_component(real "${path}" REALPATH)
    file(RELATIVE_PATH relative "${_private_fm_prefix}" "${real}")
    if(relative STREQUAL ".." OR relative MATCHES "^\\.\\./" OR IS_ABSOLUTE "${relative}")
        message(FATAL_ERROR "Private libfm: ${label} escapes expected prefix: ${path} -> ${real}")
    endif()
    file(APPEND "${CMAKE_BINARY_DIR}/private-libfm-selection.txt" "${label}=${real}\n")
endfunction()

if(NOT IS_DIRECTORY "${LIBFMQT_OVERLAY_PREFIX}")
    message(FATAL_ERROR "Set LIBFMQT_OVERLAY_PREFIX to a built private overlay")
endif()
get_filename_component(_private_fm_prefix "${LIBFMQT_OVERLAY_PREFIX}" REALPATH)
file(WRITE "${CMAKE_BINARY_DIR}/private-libfm-selection.txt" "prefix=${_private_fm_prefix}\n")
# A cached Package_DIR wins over CMAKE_PREFIX_PATH. Invalidate it explicitly,
# constrain Config-mode lookup, then independently validate the imported target.
unset(fm-qt6_DIR)
unset(fm-qt6_DIR CACHE)
find_package(fm-qt6 2.4 REQUIRED CONFIG
    PATHS "${_private_fm_prefix}/share/cmake/fm-qt6" NO_DEFAULT_PATH)
_private_fm_path("${fm-qt6_CONFIG}" "package-config")
if(NOT TARGET fm-qt6)
    message(FATAL_ERROR "Private libfm: config did not define fm-qt6")
endif()
get_target_property(_fm_imported fm-qt6 IMPORTED)
get_target_property(_fm_type fm-qt6 TYPE)
if(NOT _fm_imported OR NOT _fm_type STREQUAL "SHARED_LIBRARY")
    message(FATAL_ERROR "Private libfm: fm-qt6 must be an imported shared library")
endif()
get_target_property(_fm_configs fm-qt6 IMPORTED_CONFIGURATIONS)
set(_fm_location_properties IMPORTED_LOCATION)
foreach(_fm_config IN LISTS _fm_configs CMAKE_CONFIGURATION_TYPES CMAKE_BUILD_TYPE)
    string(TOUPPER "${_fm_config}" _fm_upper)
    list(APPEND _fm_location_properties "IMPORTED_LOCATION_${_fm_upper}")
endforeach()
# Check every advertised config, not just the generic location or build type;
# CMake may fall back to any IMPORTED_CONFIGURATIONS entry.
set(_fm_found_location FALSE)
list(REMOVE_DUPLICATES _fm_location_properties)
foreach(_fm_property IN LISTS _fm_location_properties)
    get_target_property(_fm_location fm-qt6 "${_fm_property}")
    if(_fm_location)
        _private_fm_path("${_fm_location}" "${_fm_property}")
        set(_fm_found_location TRUE)
    endif()
endforeach()
if(NOT _fm_found_location)
    message(FATAL_ERROR "Private libfm: imported library has no location")
endif()
set(_fm_headers "${_private_fm_prefix}/include/libfm-qt6")
foreach(_fm_var LIBFMQT_INCLUDE_DIR LIBFMQT_SOURCE_DIR)
    _private_fm_path("${${_fm_var}}" "${_fm_var}")
    get_filename_component(_fm_real_headers "${${_fm_var}}" REALPATH)
    get_filename_component(_fm_expected_headers "${_fm_headers}" REALPATH)
    if(NOT _fm_real_headers STREQUAL _fm_expected_headers)
        message(FATAL_ERROR "Private libfm: ${_fm_var} must use the installed overlay headers: ${_fm_headers}")
    endif()
endforeach()
_private_fm_path("${_fm_headers}/core/filetransferjob.h" "job-header")
_private_fm_path("${_fm_headers}/fm-qt6_export.h" "export-header")
get_target_property(_fm_includes fm-qt6 INTERFACE_INCLUDE_DIRECTORIES)
set(_fm_has_headers FALSE)
foreach(_fm_include IN LISTS _fm_includes)
    if("${_fm_include}" MATCHES "\\$<")
        message(FATAL_ERROR "Private libfm: unsupported include expression: ${_fm_include}")
    endif()
    # GLib/menu-cache include roots legitimately live in the SDK. Any root
    # exposing libfm itself must instead belong to this private installation.
    if(EXISTS "${_fm_include}/libfm-qt6" OR EXISTS "${_fm_include}/libfmqt.h")
        _private_fm_path("${_fm_include}" "target-include")
        set(_fm_has_headers TRUE)
    endif()
endforeach()
if(NOT _fm_has_headers)
    message(FATAL_ERROR "Private libfm: target exposes no private libfm headers")
endif()
message(STATUS "Private libfm selection verified: ${_private_fm_prefix} (private-libfm-selection.txt)")
