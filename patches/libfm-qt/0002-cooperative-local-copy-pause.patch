 void Job::cancel() {
     g_cancellable_cancel(cancellable_.get());
+    pauseCondition_.notify_all();
+}
+
+bool Job::pause() {
+    if(!supportsCooperativePause()) return false;
+    std::lock_guard<std::mutex> lock{pauseMutex_};
+    if(isCancelled()) return false;
+    pauseRequested_ = true;
+    return true;
+}
+
+void Job::resume() {
+    {
+        std::lock_guard<std::mutex> lock{pauseMutex_};
+        pauseRequested_ = false;
+        pauseAcknowledged_ = false;
+    }
+    pauseCondition_.notify_all();
+}
+
+bool Job::pauseRequested() const {
+    std::lock_guard<std::mutex> lock{pauseMutex_};
+    return pauseRequested_;
+}
+
+bool Job::isPauseAcknowledged() const {
+    std::lock_guard<std::mutex> lock{pauseMutex_};
+    return pauseAcknowledged_;
+}
+
+bool Job::waitWhilePaused() {
+    std::unique_lock<std::mutex> lock{pauseMutex_};
+    if(!pauseRequested_ || isCancelled()) return !isCancelled();
+    pauseAcknowledged_ = true;
+    pauseCondition_.wait(lock, [this] { return !pauseRequested_ || isCancelled(); });
+    pauseAcknowledged_ = false;
+    return !isCancelled();
 }
 
