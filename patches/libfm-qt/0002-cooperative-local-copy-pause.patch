+       !srcPaths_.front().isNative() || !destPaths_.front().isNative()) return false;
+    GFileInfoPtr info{g_file_query_info(srcPaths_.front().gfile().get(),
+        G_FILE_ATTRIBUTE_STANDARD_TYPE, G_FILE_QUERY_INFO_NOFOLLOW_SYMLINKS, nullptr, nullptr), false};
