-    g_cancellable_cancel(cancellable_.get());
+    requestCancellation();
+}
+
+bool Job::requestCancellation() {
+    // Publishing wakes the worker, which may complete and destroy this Job
+    // (QThreadPool autoDelete) before this call finishes. Retain what the rest
+    // of the call needs BEFORE publishing; do not touch members afterwards.
+    // The caller must keep the Job alive until this function is entered.
+    // ~Job() disconnects the GLib handler, so cancelling the retained
+    // GCancellable after destruction cannot call back into this Job.
+    // GLib invokes the callback synchronously: never hold the predicate mutex
+    // across it.
+    const std::shared_ptr<JobPauseGate> gate = pauseGate_;
+    const GCancellablePtr cancellable = cancellable_;
+    if(!gate->cancel()) return false;
+    g_cancellable_cancel(cancellable.get());
+    return true;
+}
+
+bool Job::pause() {
+    if(!supportsCooperativePause()) return false;
+    std::lock_guard<std::mutex> lock{pauseGate_->mutex};
+    if(pauseGate_->finished || pauseGate_->cancelled || isCancelled()) return false;
+    pauseGate_->requested = true;
+    return true;
+}
+
+void Job::resume() {
+    pauseGate_->resume();
+}
+
+bool Job::pauseRequested() const {
+    std::lock_guard<std::mutex> lock{pauseGate_->mutex};
+    return pauseGate_->requested;
+}
+
+bool Job::isPauseAcknowledged() const {
+    std::lock_guard<std::mutex> lock{pauseGate_->mutex};
+    return pauseGate_->acknowledged;
+}
+
+bool Job::waitWhilePaused() {
+    return pauseGate_->wait([] {});
 }
 
 void Job::run() {
     exec();
+    {
+        std::lock_guard<std::mutex> lock{pauseGate_->mutex};
+        pauseGate_->finished = true;
+        pauseGate_->requested = pauseGate_->acknowledged = false;
+        publishCompletion(pauseGate_->cancelled || isCancelled());
+    }
     Q_EMIT finished();
 }
 
