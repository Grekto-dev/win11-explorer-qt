+void FileOperationJob::publishCompletion(bool cancellationRequested) {
+    // No observer/QObject callback: this runs while the backend owns its data,
+    // before any finished handler can destroy a dialog or schedule job deletion.
+    std::lock_guard<std::mutex> lock{completion_->mutex};
+    std::uint64_t count = 0;
+    completion_->hasTotals = totalAmount(completion_->totalBytes, count);
+    finishedAmount(completion_->finishedBytes, count);
+    currentFileProgress(completion_->currentFile, completion_->currentTotal, completion_->currentDone);
+    completion_->cancellationRequested = cancellationRequested;
+    completion_->completedAt = std::chrono::steady_clock::now();
+    completion_->ready = true;
+}
