+// Private libfm-qt implementation detail; not installed as public API.
+#pragma once
+#include <mutex>
+#include <condition_variable>
+
+namespace Fm {
+class JobPauseGate {
+public:
+    mutable std::mutex mutex;
+    std::condition_variable condition;
+    bool requested = false;
+    bool acknowledged = false;
+    bool cancelled = false;
+    bool finished = false;
+
+    bool cancel() {
+        {
+            std::lock_guard<std::mutex> lock{mutex};
+            if(finished) return false;
+            cancelled = true;
+        }
+        condition.notify_all();
+        return true;
+    }
+    void resume() {
+        { std::lock_guard<std::mutex> lock{mutex}; if(finished) return; requested = acknowledged = false; }
+        condition.notify_all();
+    }
+    template<class BeforeWait> bool wait(BeforeWait beforeWait) {
+        std::unique_lock<std::mutex> lock{mutex};
+        if(!requested || cancelled) return !cancelled;
+        acknowledged = true;
+        while(requested && !cancelled) {
+            beforeWait();
+            condition.wait(lock);
+        }
+        acknowledged = false;
+        return !cancelled;
+    }
+};
+}
