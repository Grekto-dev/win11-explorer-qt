+// Existence is only ever "absent" when GIO says NOT_FOUND explicitly; any other failure of the query
+// (timeout, busy, network, permission...) is UNKNOWN and must never be treated as "we created it".
+enum class Presence { Absent, Present, Unknown };
+
+Presence queryPresence(const FilePath& path, GCancellable* cancellable = nullptr) {
+    GErrorPtr err;
+    GFileInfoPtr info{g_file_query_info(path.gfile().get(), G_FILE_ATTRIBUTE_STANDARD_TYPE,
+                                        G_FILE_QUERY_INFO_NOFOLLOW_SYMLINKS, cancellable, &err), false};
+    if(info) {
+        return Presence::Present;
+    }
+    return (err.domain() == G_IO_ERROR && err.code() == G_IO_ERROR_NOT_FOUND) ? Presence::Absent : Presence::Unknown;
+}
+
+// "Name - Cópia", "Name - Cópia (2)", ... (before the extension for files), first one that is free.
+QByteArray uniqueCopyName(const FilePath& dir, const char* name, bool isDir) {
+    const QByteArray original(name);
+    QByteArray base = original, ext;
+    const int dot = original.lastIndexOf('.');
+    if(!isDir && dot > 0 && dot < original.size() - 1) {
+        base = original.left(dot);
+        ext = original.mid(dot);
+    }
+    for(int n = 1; n < 100000; ++n) {
+        QByteArray pattern = (n == 1 ? QCoreApplication::translate("Fm::FileTransferJob", "%1 - Cópia")
+                                     : QCoreApplication::translate("Fm::FileTransferJob", "%1 - Cópia (%2)")).toUtf8();
+        pattern.replace("%2", QByteArray::number(n));
+        pattern.replace("%1", base);
+        pattern.append(ext);
+        if(queryPresence(dir.child(pattern.constData())) == Presence::Absent) {
+            return pattern;
+        }
+    }
+    return original;
+}
+
